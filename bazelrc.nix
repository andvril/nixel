{ lib, runCommand, coreutils }:

let
  inherit (lib) concatMapStringsSep;

  generate = { registries, vendor }:
    let
      lines = concatMapStringsSep "\n" (registry: "build --registry=file://${registry}") registries;
    in
    runCommand "nix.bazelrc" { } ''
      ${coreutils}/bin/cat > $out <<EOF
      # Generated by Nixel - hermetic Bazel configuration
      # This file provides flags for fully offline, reproducible Bazel builds

      build --vendor_dir=${vendor}
      ${lines}
      build --nofetch
      EOF
    '';

in
{
  inherit generate;
}
